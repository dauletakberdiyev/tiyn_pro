{
  "name": "tiyn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -b && vitest run",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/telegram-login/index.ts supabase/functions/finance-api/index.ts supabase/functions/telegram-bot/index.ts supabase/functions/reminders/index.ts",
    "setup:telegram": "node --env-file=supabase/functions/.env.local scripts/setup-telegram.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/supabase-js": "2.119.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "deno": "2.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
